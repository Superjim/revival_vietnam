"theater"
{
	"core"
	{
		"precache"
		{
			// default audio
			"sounds"			"scripts/ins_sounds_weapons.txt"		
			
			// HQ SUPPORT
			"sounds"			"scripts/audio/doi_sounds_hq_american_support.txt"		
			"sounds"			"scripts/audio/doi_sounds_hq_commonwealth_support.txt"	
			"sounds"			"scripts/audio/doi_sounds_hq_german_support.txt"				
			
			// Co-op
			"sounds"			"scripts/audio/doi_sounds_voice_coop.txt"	

			// Units		
			"sounds"			"scripts/audio/doi_sounds_unit_radial_canadian.txt"		
			"sounds"         	"scripts/audio/doi_sounds_unit_responses_canadian.txt"		
			"sounds"			"scripts/audio/doi_sounds_unit_hq_canadian.txt"
			
			"sounds"			"scripts/audio/doi_sounds_unit_radial_africanamerican.txt"		
			"sounds"        	"scripts/audio/doi_sounds_unit_responses_africanamerican.txt"	
